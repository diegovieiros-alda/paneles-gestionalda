DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=paneles.gestionalda.es,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://paneles.gestionalda.es

DB_NAME=paneles_gestionalda
DB_USER=paneles_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Conexión de solo lectura a la base de datos de Odoo (PMS), usada por
# core/bloqueos para calcular el informe de habitaciones bloqueadas.
ODOO_DB_HOST=
ODOO_DB_NAME=odoo
ODOO_DB_USER=readonly_user
ODOO_DB_PASSWORD=
ODOO_DB_PORT=5432
ODOO_DB_SSLMODE=require

# Ruta a la credencial JSON de una cuenta de servicio de Google, usada por
# `manage.py importar_presupuesto_fb` para leer la hoja de presupuesto de
# desayuno de Finanzas. Crear la cuenta de servicio en Google Cloud
# Console (IAM y administración > Cuentas de servicio), habilitar la
# Google Sheets API en ese proyecto, descargar su clave JSON, y compartir
# la hoja con el email de la cuenta de servicio como "Lector". Sin esto
# configurado, el comando falla con un mensaje explícito en vez de un
# traceback — no bloquea el resto de la aplicación.
GOOGLE_SHEETS_CREDENTIALS_FILE=
